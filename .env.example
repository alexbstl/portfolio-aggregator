SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# Required (unless AUTH_DISABLED=true): application-layer auth token. The app
# FAILS CLOSED (HTTP 503) if this is unset, so it can't silently run
# unauthenticated. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# Optional
# Set true to DISABLE auth entirely and run wide open — only do this when
# another layer already gates access (Caddy basic-auth, Tailscale-only, trusted
# LAN). Deliberate opt-out; an unset APP_TOKEN alone still fails closed.
# AUTH_DISABLED=false
# Set true only when the app is always fronted by HTTPS (e.g. Caddy); leave
# false for plain-HTTP access over LAN/Tailscale so the login cookie is sent.
# APP_COOKIE_SECURE=false
# DATABASE_PATH=./data/portfolio.db
# SYNC_INTERVAL_MINUTES=15
